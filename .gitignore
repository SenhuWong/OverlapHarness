# Local build and editor state
/build/
/build-*/
/artifacts/build/
/artifacts/install/
/.cache/
/.venv/
.DS_Store
*~
*.swp

# Compiled and profiling output
*.o
*.a
*.so
*.dylib
*.prof
*.trace

# Ignore machine-local artifacts by default; keep curated research records.
/artifacts/*
!/artifacts/README.md
!/artifacts/_template/
!/artifacts/_template/**
!/artifacts/records/
!/artifacts/records/**
